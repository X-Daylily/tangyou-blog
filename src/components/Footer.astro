---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer>
	<div class="inner">
		<div class="meta">
			<p class="brand">{SITE_TITLE}</p>
			<p class="copy">© {today.getFullYear()} {SITE_AUTHOR}</p>
		</div>
		<SocialLinks />
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		border-top: 1px solid var(--border);
		background: var(--bg-soft);
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		max-width: var(--maxw-wide);
		margin: 0 auto;
		padding: 2rem 1.25rem;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.brand {
		margin: 0;
		font-weight: 600;
		color: var(--text);
	}
	.copy {
		margin: 0;
		font-size: 0.88rem;
		color: var(--text-muted);
	}
</style>
