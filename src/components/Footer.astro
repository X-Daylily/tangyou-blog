---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';
import Ornament from './Ornament.astro';

const today = new Date();
---

<footer>
	<div class="inner">
		<Ornament />
		<div class="row">
			<div class="meta">
				<p class="brand">{SITE_TITLE}</p>
				<p class="copy">© {today.getFullYear()} {SITE_AUTHOR}</p>
			</div>
			<SocialLinks />
		</div>
	</div>
</footer>

<style>
	footer {
		position: relative;
		margin-top: 5rem;
	}
	/* 鎏金发丝上边线 */
	footer::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
	}
	.inner {
		max-width: var(--maxw-wide);
		margin: 0 auto;
		padding: 0.5rem 1.25rem 2.4rem;
	}
	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.brand {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: 0.09em;
		color: var(--accent);
	}
	.copy {
		margin: 0;
		font-size: 0.86rem;
		color: var(--text-muted);
		letter-spacing: 0.06em;
	}
</style>
