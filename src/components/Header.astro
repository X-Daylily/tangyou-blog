---
import { SITE_TITLE } from '../consts';
import FloatingFood from './FloatingFood.astro';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';

// 飘浮金尘：用正弦做确定性伪随机，避免每次构建结果不同
const DUST = Array.from({ length: 14 }, (_, i) => {
	const rnd = (n: number) => {
		const v = Math.sin((i + 1) * n) * 43758.5453;
		return v - Math.floor(v);
	};
	return {
		x: +(rnd(12.9898) * 100).toFixed(2),
		size: +(1.4 + rnd(78.233) * 2.3).toFixed(2),
		dur: +(22 + rnd(45.164) * 24).toFixed(2),
		delay: -(rnd(93.989) * 46).toFixed(2),
		dx: +((rnd(23.14) - 0.5) * 70).toFixed(1),
	};
});
---

<div class="ambient" aria-hidden="true">
	<div class="cursor-glow"></div>
	<div class="dust">
		{DUST.map((d) => (
			<span
				style={`left:${d.x}%; width:${d.size}px; height:${d.size}px; animation-duration:${d.dur}s; animation-delay:${d.delay}s; --dx:${d.dx}px;`}
			/>
		))}
	</div>
	<FloatingFood />
</div>

<header>
	<a href="#main-content" class="skip-link">
		跳到正文
	</a>
	<div class="topbar">
		<a class="brand" href="/">
			<Logo size={40} />
			<span class="name">{SITE_TITLE}</span>
		</a>

		<nav class="internal-links" aria-label="主导航">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</nav>

		<div class="actions">
			<SocialLinks />
			<button
				id="theme-toggle"
				class="theme-toggle"
				type="button"
				aria-label="切换深色模式"
				aria-pressed="false"
				title="切换深色模式"
			>
				<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"
					/>
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.7" />
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						d="M12 2v2.2M12 19.8V22M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2 12h2.2M19.8 12H22M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"
					/>
				</svg>
			</button>
		</div>
	</div>

	<!-- 阅读进度条（纯装饰，进度由脚本写入） -->
	<div class="progress" aria-hidden="true">
		<span class="progress-bar"></span>
	</div>
</header>

<button class="to-top" type="button" aria-label="回到顶部" title="回到顶部">
	<Logo size={30} />
</button>

<script>
	const root = document.documentElement;

	/* ——— 主题切换 ——— */
	const toggle = document.getElementById('theme-toggle');
	const themeMeta = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
	const THEME_COLORS = { light: '#fbf3e7', dark: '#0b0d16' } as const;

	const applyTheme = (theme: 'light' | 'dark') => {
		root.dataset.theme = theme;
		const dark = theme === 'dark';
		const label = dark ? '切换到浅色模式' : '切换到深色模式';
		toggle?.setAttribute('aria-pressed', String(dark));
		toggle?.setAttribute('aria-label', label);
		toggle?.setAttribute('title', label);
		for (const meta of themeMeta) meta.setAttribute('content', THEME_COLORS[theme]);
	};

	// 与 BaseHead 里的内联脚本对齐（避免按钮状态与实际主题不一致）
	applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

	toggle?.addEventListener('click', () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		applyTheme(next);
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});

	// 其他标签页切换主题时同步
	addEventListener('storage', (e) => {
		if (e.key !== 'theme') return;
		applyTheme(e.newValue === 'dark' ? 'dark' : 'light');
	});

	// 没手动选过主题时，跟随系统变化
	const systemDark = matchMedia('(prefers-color-scheme: dark)');
	systemDark.addEventListener?.('change', (e) => {
		let stored: string | null = null;
		try {
			stored = localStorage.getItem('theme');
		} catch {}
		if (!stored) applyTheme(e.matches ? 'dark' : 'light');
	});

	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	/* ——— 滚动：进度条 / 顶栏收缩 / 回到顶部 ——— */
	const bar = document.querySelector<HTMLElement>('.progress-bar');
	const header = document.querySelector('header');
	const toTop = document.querySelector<HTMLElement>('.to-top');
	let ticking = false;

	const onScroll = () => {
		ticking = false;
		const doc = document.documentElement;
		const max = doc.scrollHeight - doc.clientHeight;
		const p = max > 0 ? Math.min(1, Math.max(0, doc.scrollTop / max)) : 0;
		if (bar) bar.style.transform = `scaleX(${p.toFixed(4)})`;
		header?.classList.toggle('is-scrolled', doc.scrollTop > 16);
		// 回到顶部：短页面也能出现，阈值随页面高度自适应
		const revealAt = Math.min(600, max * 0.35);
		toTop?.classList.toggle('is-visible', max > 120 && doc.scrollTop > revealAt);
	};

	const requestTick = () => {
		if (!ticking) {
			ticking = true;
			requestAnimationFrame(onScroll);
		}
	};

	addEventListener('scroll', requestTick, { passive: true });
	addEventListener('resize', requestTick, { passive: true });
	onScroll();

	toTop?.addEventListener('click', () => {
		scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
	});

	/* ——— 滚动渐显 ——— */
	{
		const items = [...document.querySelectorAll('[data-reveal]')];
		if (reduceMotion || !('IntersectionObserver' in window)) {
			items.forEach((el) => el.classList.add('is-visible'));
		} else {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					}
				},
				{ rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
			);
			items.forEach((el) => io.observe(el));
		}
	}

	/* ——— 跟随鼠标的鎏金辉光 ——— */
	{
		const glow = document.querySelector<HTMLElement>('.cursor-glow');
		const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
		if (glow && fine && !reduceMotion) {
			let tx = innerWidth / 2;
			let ty = innerHeight * 0.32;
			let cx = tx;
			let cy = ty;
			let raf = 0;

			glow.style.opacity = '1';
			glow.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;

			const tick = () => {
				cx += (tx - cx) * 0.1;
				cy += (ty - cy) * 0.1;
				glow.style.transform = `translate3d(${cx.toFixed(1)}px, ${cy.toFixed(1)}px, 0)`;
				raf = Math.abs(tx - cx) > 0.4 || Math.abs(ty - cy) > 0.4 ? requestAnimationFrame(tick) : 0;
			};

			addEventListener(
				'pointermove',
				(e) => {
					tx = e.clientX;
					ty = e.clientY;
					if (!raf) raf = requestAnimationFrame(tick);
				},
				{ passive: true },
			);
		}
	}
</script>

<style>
	/* ————— 环境层：鼠标辉光 + 飘浮金尘（压在内容底下） ————— */
	.ambient {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}
	.cursor-glow {
		position: fixed;
		top: 0;
		left: 0;
		width: 46rem;
		height: 46rem;
		margin: -23rem 0 0 -23rem;
		border-radius: 50%;
		background: radial-gradient(circle, var(--bloom-1), transparent 62%);
		filter: blur(34px);
		opacity: 0;
		transition: opacity 0.7s ease;
		will-change: transform;
	}
	.dust span {
		position: absolute;
		bottom: -6vh;
		border-radius: 50%;
		background: var(--grad-gold);
		box-shadow: 0 0 10px var(--glow-1);
		opacity: 0;
		animation-name: dust-rise;
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
	}
	@keyframes dust-rise {
		0% {
			opacity: 0;
			transform: translate3d(0, 0, 0) scale(0.6);
		}
		12% {
			opacity: 0.85;
		}
		80% {
			opacity: 0.45;
		}
		100% {
			opacity: 0;
			transform: translate3d(var(--dx, 0px), -114vh, 0) scale(1.15);
		}
	}

	/* ————— 顶栏 ————— */
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--bg);
		background: color-mix(in srgb, var(--bg) 58%, transparent);
		backdrop-filter: blur(22px) saturate(170%);
		-webkit-backdrop-filter: blur(22px) saturate(170%);
		transition: box-shadow 0.35s ease;
	}
	header.is-scrolled {
		box-shadow: 0 12px 34px rgba(120, 92, 48, 0.14);
	}
	:global(:root[data-theme='dark']) header.is-scrolled {
		box-shadow: 0 12px 34px rgba(0, 0, 0, 0.5);
	}
	/* 顶部一线鎏金 */
	header::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--glow-1),
			var(--glow-2),
			var(--glow-3),
			transparent
		);
		opacity: 0.85;
	}

	.topbar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		max-width: var(--maxw-wide);
		margin: 0 auto;
		padding: 0.72rem 1.25rem;
		transition: padding 0.35s ease;
	}
	header.is-scrolled .topbar {
		padding: 0.42rem 1.25rem;
	}

	/* 阅读进度条（同时充当顶栏底边线） */
	.progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--border), transparent);
	}
	.progress-bar {
		display: block;
		height: 100%;
		transform: scaleX(0);
		transform-origin: 0 50%;
		background: var(--grad-gold);
		box-shadow: 0 0 14px var(--glow-1);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
	}
	.brand .name {
		font-family: var(--font-display);
		font-size: 1.14rem;
		font-weight: 600;
		letter-spacing: 0.09em;
	}
	.brand:hover {
		text-decoration: none;
	}
	.brand:hover .name {
		background: var(--grad-ink);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
	}
	.brand :global(.logo) {
		transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.brand:hover :global(.logo) {
		transform: scale(1.08) rotate(-4deg);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		margin-left: auto;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-left: 0.5rem;
	}

	.theme-toggle {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 999px;
		color: var(--text-muted);
		cursor: pointer;
		background:
			linear-gradient(var(--surface), var(--surface)) padding-box,
			linear-gradient(135deg, var(--glow-1), var(--glow-3)) border-box;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: var(--inner-top);
		transition:
			color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.25s ease;
	}
	.theme-toggle:hover {
		color: var(--accent);
		box-shadow: var(--glow);
		transform: rotate(-12deg);
	}
	.theme-toggle .icon-sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .theme-toggle .icon-moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .theme-toggle .icon-sun {
		display: block;
	}

	/* ————— 回到顶部 ————— */
	.to-top {
		position: fixed;
		right: 1.4rem;
		bottom: 1.4rem;
		z-index: 60;
		display: grid;
		place-items: center;
		width: 54px;
		height: 54px;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 50%;
		cursor: pointer;
		background:
			linear-gradient(var(--surface-2), var(--surface-2)) padding-box,
			linear-gradient(135deg, var(--glow-1), var(--glow-2) 50%, var(--glow-3)) border-box;
		backdrop-filter: blur(14px) saturate(160%);
		-webkit-backdrop-filter: blur(14px) saturate(160%);
		box-shadow: var(--shadow), var(--inner-top);
		opacity: 0;
		transform: translateY(14px) scale(0.9);
		pointer-events: none;
		transition:
			opacity 0.4s ease,
			transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
			box-shadow 0.3s ease;
	}
	.to-top.is-visible {
		opacity: 1;
		transform: none;
		pointer-events: auto;
	}
	.to-top:hover {
		box-shadow: var(--glow);
	}
	.to-top:hover :global(.logo) {
		transform: translateY(-3px);
	}
	.to-top :global(.logo) {
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	@media (max-width: 640px) {
		.topbar {
			padding: 0.55rem 0.9rem;
			gap: 0.4rem;
		}
		header.is-scrolled .topbar {
			padding: 0.4rem 0.9rem;
		}
		.brand .name {
			font-size: 1rem;
			letter-spacing: 0.05em;
		}
		.internal-links {
			gap: 0;
		}
		.actions :global(.social-links) {
			display: none;
		}
		.to-top {
			right: 1rem;
			bottom: 1rem;
			width: 48px;
			height: 48px;
		}
	}

	/* 窄屏只保留 logo，给导航让位 */
	@media (max-width: 540px) {
		.brand .name {
			display: none;
		}
	}
</style>
