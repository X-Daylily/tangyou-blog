---
/**
 * 会动的「糖油糍粑」logo
 * - 糖油糍粑本体：微微 Q 弹（软糯）的果冻感缩放
 * - 冒热气：三缕热气依次升起
 * - 糖油高光：缓慢呼吸式闪烁
 */
interface Props {
	/** 显示尺寸（px） */
	size?: number;
}

const { size = 38 } = Astro.props;

// 同页多次使用时 defs 内容完全一致，固定 id 不会造成视觉问题
const uid = 'ciba';
---

<span class="logo" style={`--logo-size:${size}px`} aria-hidden="true">
	<svg viewBox="0 0 64 64" width={size} height={size} focusable="false">
		<defs>
			<linearGradient id={`${uid}-cake`} x1="0" y1="0" x2="0.3" y2="1">
				<stop offset="0%" stop-color="#fdf3e0"></stop>
				<stop offset="55%" stop-color="#f1ddb7"></stop>
				<stop offset="100%" stop-color="#d8bb89"></stop>
			</linearGradient>
			<linearGradient id={`${uid}-syrup`} x1="0" y1="0" x2="0.35" y2="1">
				<stop offset="0%" stop-color="#d68f36"></stop>
				<stop offset="45%" stop-color="#a9641f"></stop>
				<stop offset="100%" stop-color="#6d380a"></stop>
			</linearGradient>
			<radialGradient id={`${uid}-glow`} cx="50%" cy="55%" r="50%">
				<stop offset="0%" stop-color="#f3b969" stop-opacity="0.5"></stop>
				<stop offset="100%" stop-color="#f3b969" stop-opacity="0"></stop>
			</radialGradient>
			<clipPath id={`${uid}-clip`}>
				<ellipse cx="32" cy="41" rx="20" ry="15.5"></ellipse>
			</clipPath>
		</defs>

		<!-- 光晕 -->
		<ellipse class="glow" cx="32" cy="42" rx="28" ry="25" fill={`url(#${uid}-glow)`}></ellipse>

		<!-- 热气 -->
		<g class="steam" fill="none" stroke="#c98c45" stroke-width="2.2" stroke-linecap="round">
			<path class="s1" d="M24 26c-2.6-4 2.6-6 0-10.5"></path>
			<path class="s2" d="M32 26c-2.6-4 2.6-6 0-10.5"></path>
			<path class="s3" d="M40 26c-2.6-4 2.6-6 0-10.5"></path>
		</g>

		<!-- 落地阴影 -->
		<ellipse cx="32" cy="58" rx="14" ry="2.4" fill="#7a4a12" opacity="0.16"></ellipse>

		<!-- 糍粑本体（会 Q 弹） -->
		<g class="cake">
			<ellipse cx="32" cy="41" rx="20" ry="15.5" fill={`url(#${uid}-cake)`}></ellipse>

			<g clip-path={`url(#${uid}-clip)`}>
				<!-- 糖油（带垂坠感的波浪下缘） -->
				<path
					d="M9 22 L55 22 L55 38 C53 42.5 48 42.5 46 38 C44 42.5 39 42.5 37 38 C35 42.5 30 42.5 28 38 C26 42.5 21 42.5 19 38 C17 42.5 12 42.5 9 38 Z"
					fill={`url(#${uid}-syrup)`}></path>

				<!-- 糖油高光 -->
				<ellipse
					class="gloss"
					cx="23"
					cy="31"
					rx="7"
					ry="3.1"
					fill="#ffffff"
					transform="rotate(-20 23 31)"></ellipse>
				<ellipse
					class="gloss g2"
					cx="40"
					cy="30"
					rx="3.4"
					ry="1.6"
					fill="#ffffff"
					transform="rotate(-16 40 30)"></ellipse>

				<!-- 芝麻 -->
				<ellipse cx="28" cy="28" rx="1.1" ry="0.72" fill="#f9efd8" transform="rotate(20 28 28)"></ellipse>
				<ellipse cx="35" cy="29.5" rx="1" ry="0.68" fill="#f9efd8" transform="rotate(-24 35 29.5)"></ellipse>
				<ellipse cx="23" cy="35" rx="0.95" ry="0.62" fill="#f9efd8" transform="rotate(12 23 35)"></ellipse>
				<ellipse cx="41" cy="34" rx="0.9" ry="0.6" fill="#f9efd8" transform="rotate(-16 41 34)"></ellipse>
			</g>
		</g>
	</svg>
</span>

<style>
	.logo {
		display: inline-grid;
		place-items: center;
		width: var(--logo-size, 38px);
		height: var(--logo-size, 38px);
		flex: none;
		transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.logo svg {
		display: block;
		overflow: visible;
	}

	/* 软糯 Q 弹 */
	@keyframes jelly {
		0%,
		100% {
			transform: scale(1, 1);
		}
		22% {
			transform: scale(1.065, 0.935);
		}
		46% {
			transform: scale(0.962, 1.048);
		}
		68% {
			transform: scale(1.028, 0.982);
		}
		85% {
			transform: scale(0.996, 1.012);
		}
	}
	.cake {
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: jelly 3.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
	}

	/* 冒热气 */
	@keyframes steam {
		0% {
			opacity: 0;
			transform: translateY(4px) scale(0.9);
		}
		35% {
			opacity: 0.85;
		}
		100% {
			opacity: 0;
			transform: translateY(-9px) scale(1.05);
		}
	}
	.steam path {
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: steam 3.4s ease-in-out infinite;
	}
	.s2 {
		animation-delay: 0.55s;
	}
	.s3 {
		animation-delay: 1.1s;
	}

	/* 糖油高光呼吸 */
	@keyframes glossPulse {
		0%,
		100% {
			opacity: 0.32;
		}
		50% {
			opacity: 0.62;
		}
	}
	.gloss {
		animation: glossPulse 4.2s ease-in-out infinite;
	}
	.g2 {
		animation-delay: 1.4s;
	}

	/* 光晕呼吸 */
	@keyframes glowPulse {
		0%,
		100% {
			opacity: 0.6;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.07);
		}
	}
	.glow {
		transform-box: fill-box;
		transform-origin: 50% 50%;
		animation: glowPulse 5s ease-in-out infinite;
	}
</style>
