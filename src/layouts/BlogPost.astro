---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Ornament from '../components/Ornament.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';

interface PostLink {
	title: string;
	id: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
	readingTime?: string;
	prev?: PostLink | null;
	next?: PostLink | null;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	headings = [],
	readingTime,
	prev,
	next,
	draft,
} = Astro.props;

const toc = headings.filter((h) => h.depth > 1 && h.depth <= 3);
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	image: heroImage ? new URL(heroImage.src, Astro.site).href : undefined,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: SITE_AUTHOR },
	publisher: { '@type': 'Organization', name: SITE_TITLE },
	mainEntityOfPage: canonical.href,
	keywords: tags.join(','),
};
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			noindex={import.meta.env.PROD && draft}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			main {
				max-width: 100%;
				padding: 0 1rem;
			}
			.hero {
				max-width: var(--maxw-wide);
				margin: 2.5rem auto 0;
			}
			.hero img {
				width: 100%;
				height: auto;
				display: block;
				border-radius: var(--radius-lg);
				border: 1px solid var(--border);
				box-shadow: var(--shadow-lg);
			}

			/* 琉璃书页：与头图叠压，制造层次 */
			.sheet {
				position: relative;
				z-index: 2;
				max-width: 860px;
				margin: 3rem auto 0;
				padding: 3.2rem 3rem 3.6rem;
			}
			.sheet.overlap {
				margin-top: -4rem;
			}

			.title {
				text-align: center;
			}
			.title h1 {
				margin: 0 0 1rem;
				letter-spacing: 0.07em;
				text-shadow: 0 2px 22px rgba(198, 152, 78, 0.22);
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.55rem 0.8rem;
				color: var(--text-muted);
				font-size: 0.86rem;
				letter-spacing: 0.08em;
			}
			.meta .sep {
				width: 5px;
				height: 5px;
				transform: rotate(45deg);
				background: var(--grad-gold);
				opacity: 0.8;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.55rem;
				list-style: none;
				margin: 1.3rem 0 0;
				padding: 0;
			}
			.tags a {
				display: inline-block;
				padding: 0.24em 0.95em;
				border-radius: 999px;
				border: 1px solid transparent;
				background:
					linear-gradient(var(--accent-soft), var(--accent-soft)) padding-box,
					linear-gradient(135deg, var(--glow-1), var(--glow-3)) border-box;
				color: var(--accent);
				font-size: 0.79rem;
				letter-spacing: 0.1em;
				text-decoration: none;
				transition: box-shadow 0.3s ease;
			}
			.tags a:hover {
				box-shadow: var(--glow);
				text-decoration: none;
			}

			.toc {
				margin: 0 0 2.8rem;
				padding: 1.4rem 1.7rem;
				border-radius: var(--radius);
				border: 1px solid var(--border);
				border-left: 3px solid var(--accent);
				background: var(--accent-soft);
			}
			.toc h2 {
				margin: 0 0 0.8rem;
				font-size: 0.82rem;
				font-weight: 600;
				letter-spacing: 0.32em;
				color: var(--text-muted);
			}
			.toc ul {
				margin: 0;
				padding-left: 1.1em;
			}
			.toc li {
				margin: 0.32em 0;
			}
			.toc .toc-depth-3 {
				margin-left: 1em;
				font-size: 0.95rem;
			}

			.post-nav {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.1rem;
				margin-top: 4rem;
			}
			.post-nav a {
				display: flex;
				flex-direction: column;
				gap: 0.32rem;
				padding: 1.2rem 1.4rem;
				border: 1px solid transparent;
				border-radius: var(--radius);
				background:
					linear-gradient(var(--surface), var(--surface)) padding-box,
					linear-gradient(135deg, var(--glow-1), var(--glow-3)) border-box;
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
				text-decoration: none;
				transition:
					box-shadow 0.35s ease,
					transform 0.35s ease;
			}
			.post-nav a:hover {
				box-shadow: var(--glow);
				transform: translateY(-4px);
				text-decoration: none;
			}
			.post-nav .label {
				font-size: 0.74rem;
				letter-spacing: 0.2em;
				color: var(--text-muted);
			}
			.post-nav .t {
				font-family: var(--font-display);
				font-weight: 600;
				letter-spacing: 0.04em;
				color: var(--text);
			}
			.post-nav .next {
				text-align: right;
			}

			@media (max-width: 720px) {
				.sheet {
					padding: 2.2rem 1.4rem 2.6rem;
					margin-top: 2rem;
				}
				.sheet.overlap {
					margin-top: -2rem;
				}
				.post-nav {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content">
			<article>
				{heroImage && (
					<div class="hero">
						<Image
							src={heroImage}
							alt={title}
							widths={[480, 768, 1020]}
							sizes="(max-width: 1100px) 100vw, 1020px"
							priority
						/>
					</div>
				)}

				<div class:list={['sheet', 'glass', 'rise', heroImage && 'overlap']}>
					<header class="title">
						<h1>{title}</h1>
						<div class="meta">
							<FormattedDate date={pubDate} />
							{readingTime && <span class="sep" />}
							{readingTime && <span>约 {readingTime}</span>}
							{updatedDate && <span class="sep" />}
							{updatedDate && (
								<span>
									最后更新于 <FormattedDate date={updatedDate} />
								</span>
							)}
						</div>
						{tags.length > 0 && (
							<ul class="tags">
								{tags.map((tag) => (
									<li>
										<a href={`/tags/${tag}/`}>#{tag}</a>
									</li>
								))}
							</ul>
						)}
					</header>

					<Ornament />

					{toc.length > 0 && (
						<nav class="toc" aria-label="目录">
							<h2>目录</h2>
							<ul>
								{toc.map((h) => (
									<li class={`toc-depth-${h.depth}`}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</nav>
					)}

					<div class="prose">
						<slot />
					</div>

					{(prev || next) && (
						<nav class="post-nav" aria-label="上一篇 / 下一篇">
							{prev ? (
								<a class="prev" href={`/blog/${prev.id}/`}>
									<span class="label">← 上一篇</span>
									<span class="t">{prev.title}</span>
								</a>
							) : (
								<span />
							)}
							{next && (
								<a class="next" href={`/blog/${next.id}/`}>
									<span class="label">下一篇 →</span>
									<span class="t">{next.title}</span>
								</a>
							)}
						</nav>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
