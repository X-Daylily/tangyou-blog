---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Ornament from '../components/Ornament.astro';
import { SITE_AUTHOR, SITE_TITLE, SITE_URL } from '../consts';

interface PostLink {
	title: string;
	id: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
	readingTime?: string;
	prev?: PostLink | null;
	next?: PostLink | null;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	headings = [],
	readingTime,
	prev,
	next,
	draft,
} = Astro.props;

const toc = headings.filter((h) => h.depth > 1 && h.depth <= 3);

const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, site);
const blogUrl = new URL('/blog/', site).href;

// 结构化数据：文章本体 + 面包屑，便于搜索结果展示
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'BlogPosting',
			headline: title,
			description,
			image: heroImage ? new URL(heroImage.src, site).href : undefined,
			datePublished: pubDate.toISOString(),
			dateModified: (updatedDate ?? pubDate).toISOString(),
			author: { '@type': 'Person', name: SITE_AUTHOR },
			publisher: { '@type': 'Organization', name: SITE_TITLE },
			mainEntityOfPage: canonical.href,
			url: canonical.href,
			inLanguage: 'zh-CN',
			keywords: tags.join(','),
			isPartOf: { '@type': 'Blog', name: SITE_TITLE, url: blogUrl },
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', site).href },
				{ '@type': 'ListItem', position: 2, name: '文章', item: blogUrl },
				{ '@type': 'ListItem', position: 3, name: title, item: canonical.href },
			],
		},
	],
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			imageAlt={title}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate ?? pubDate}
			noindex={import.meta.env.PROD && draft}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			main {
				max-width: 100%;
				padding: 0 1rem;
			}
			.hero {
				max-width: var(--maxw-wide);
				margin: 2.5rem auto 0;
			}
			.hero img {
				width: 100%;
				height: auto;
				display: block;
				border-radius: var(--radius-lg);
				border: 1px solid var(--border);
				box-shadow: var(--shadow-lg);
			}

			/* 琉璃书页：与头图叠压，制造层次 */
			.sheet {
				position: relative;
				z-index: 2;
				max-width: 860px;
				margin: 3rem auto 0;
				padding: 3.2rem 3rem 3.6rem;
			}
			.sheet.overlap {
				margin-top: -4rem;
			}

			.title {
				text-align: center;
			}

			/* 正文收窄到约 42rem，中文行宽更舒服 */
			.prose {
				max-width: 42rem;
				margin: 0 auto;
			}
			.prose :global(pre) {
				position: relative;
			}
			.prose :global(.copy-code) {
				position: absolute;
				top: 0.55rem;
				right: 0.55rem;
				padding: 0.22em 0.75em;
				border: 1px solid rgba(255, 255, 255, 0.18);
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.08);
				color: #e9dfcd;
				font-family: var(--font-sans);
				font-size: 0.72rem;
				letter-spacing: 0.08em;
				cursor: pointer;
				opacity: 0;
				transition:
					opacity 0.25s ease,
					background-color 0.25s ease,
					color 0.25s ease;
			}
			.prose :global(pre:hover .copy-code),
			.prose :global(.copy-code:focus-visible),
			.prose :global(.copy-code.is-done) {
				opacity: 1;
			}
			.prose :global(.copy-code:hover) {
				background: rgba(255, 255, 255, 0.18);
				color: #fff8ec;
			}
			.prose :global(.copy-code.is-done) {
				border-color: var(--glow-1);
				color: var(--glow-1);
			}
			@media (hover: none) {
				.prose :global(.copy-code) {
					opacity: 0.8;
				}
			}
			.title h1 {
				margin: 0 0 1rem;
				letter-spacing: 0.07em;
				text-shadow: 0 2px 22px rgba(198, 152, 78, 0.22);
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.55rem 0.8rem;
				color: var(--text-muted);
				font-size: 0.86rem;
				letter-spacing: 0.08em;
			}
			.meta .sep {
				width: 5px;
				height: 5px;
				transform: rotate(45deg);
				background: var(--grad-gold);
				opacity: 0.8;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.55rem;
				list-style: none;
				margin: 1.3rem 0 0;
				padding: 0;
			}
			.tags a {
				display: inline-block;
				padding: 0.24em 0.95em;
				border-radius: 999px;
				border: 1px solid transparent;
				background:
					linear-gradient(var(--accent-soft), var(--accent-soft)) padding-box,
					linear-gradient(135deg, var(--glow-1), var(--glow-3)) border-box;
				color: var(--accent);
				font-size: 0.79rem;
				letter-spacing: 0.1em;
				text-decoration: none;
				transition: box-shadow 0.3s ease;
			}
			.tags a:hover {
				box-shadow: var(--glow);
				text-decoration: none;
			}

			.toc {
				max-width: 42rem;
				margin: 0 auto 2.8rem;
				padding: 1.4rem 1.7rem;
				border-radius: var(--radius);
				border: 1px solid var(--border);
				border-left: 3px solid var(--accent);
				background: var(--accent-soft);
			}
			.toc h2 {
				margin: 0 0 0.8rem;
				font-size: 0.82rem;
				font-weight: 600;
				letter-spacing: 0.32em;
				color: var(--text-muted);
			}
			.toc ul {
				margin: 0;
				padding-left: 1.1em;
			}
			.toc li {
				margin: 0.32em 0;
			}
			.toc .toc-depth-3 {
				margin-left: 1em;
				font-size: 0.95rem;
			}
			.toc a {
				transition:
					color 0.25s ease,
					font-weight 0.25s ease;
			}
			.toc a.active {
				color: var(--accent);
				font-weight: 700;
			}
			.toc a.active::after {
				content: '◆';
				margin-left: 0.45em;
				font-size: 0.6em;
				vertical-align: 0.25em;
				color: var(--accent);
				opacity: 0.85;
			}

			.post-nav {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.1rem;
				margin-top: 4rem;
			}
			.post-nav a {
				display: flex;
				flex-direction: column;
				gap: 0.32rem;
				padding: 1.2rem 1.4rem;
				border: 1px solid transparent;
				border-radius: var(--radius);
				background:
					linear-gradient(var(--surface), var(--surface)) padding-box,
					linear-gradient(135deg, var(--glow-1), var(--glow-3)) border-box;
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
				text-decoration: none;
				transition:
					box-shadow 0.35s ease,
					transform 0.35s ease;
			}
			.post-nav a:hover {
				box-shadow: var(--glow);
				transform: translateY(-4px);
				text-decoration: none;
			}
			.post-nav .label {
				font-size: 0.74rem;
				letter-spacing: 0.2em;
				color: var(--text-muted);
			}
			.post-nav .t {
				font-family: var(--font-display);
				font-weight: 600;
				letter-spacing: 0.04em;
				color: var(--text);
			}
			.post-nav .next {
				text-align: right;
			}

			@media (max-width: 720px) {
				.sheet {
					padding: 2.2rem 1.4rem 2.6rem;
					margin-top: 2rem;
				}
				.sheet.overlap {
					margin-top: -2rem;
				}
				.post-nav {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content">
			<article>
				{heroImage && (
					<div class="hero">
						<Image
							src={heroImage}
							alt={title}
							widths={[480, 768, 1020]}
							sizes="(max-width: 1100px) 100vw, 1020px"
							priority
						/>
					</div>
				)}

				<div class:list={['sheet', 'glass', 'rise', heroImage && 'overlap']}>
					<header class="title">
						<h1>{title}</h1>
						<div class="meta">
							<FormattedDate date={pubDate} />
							{readingTime && <span class="sep" />}
							{readingTime && <span>约 {readingTime}</span>}
							{updatedDate && <span class="sep" />}
							{updatedDate && (
								<span>
									最后更新于 <FormattedDate date={updatedDate} />
								</span>
							)}
						</div>
						{tags.length > 0 && (
							<ul class="tags">
								{tags.map((tag) => (
									<li>
										<a href={`/tags/${tag}/`}>#{tag}</a>
									</li>
								))}
							</ul>
						)}
					</header>

					<Ornament />

					{toc.length > 0 && (
						<nav class="toc" aria-label="目录">
							<h2>目录</h2>
							<ul>
								{toc.map((h) => (
									<li class={`toc-depth-${h.depth}`}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</nav>
					)}

					<div class="prose">
						<slot />
					</div>

					{(prev || next) && (
						<nav class="post-nav" aria-label="上一篇 / 下一篇" data-reveal>
							{prev ? (
								<a class="prev" href={`/blog/${prev.id}/`}>
									<span class="label">← 上一篇</span>
									<span class="t">{prev.title}</span>
								</a>
							) : (
								<span />
							)}
							{next && (
								<a class="next" href={`/blog/${next.id}/`}>
									<span class="label">下一篇 →</span>
									<span class="t">{next.title}</span>
								</a>
							)}
						</nav>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<script>
	// 目录高亮跟随阅读位置
	const toc = document.querySelector('.toc');
	if (toc) {
		const map = new Map<Element, HTMLAnchorElement>();
		for (const a of toc.querySelectorAll<HTMLAnchorElement>('a')) {
			const id = decodeURIComponent((a.getAttribute('href') ?? '').slice(1));
			const el = id ? document.getElementById(id) : null;
			if (el) map.set(el, a);
		}

		if (map.size > 0 && 'IntersectionObserver' in window) {
			let active: HTMLAnchorElement | null = null;
			const setActive = (link: HTMLAnchorElement | undefined) => {
				if (!link || link === active) return;
				active?.classList.remove('active');
				active = link;
				active.classList.add('active');
			};

			const io = new IntersectionObserver(
				(entries) => {
					const hit = entries
						.filter((e) => e.isIntersecting)
						.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
					if (hit) setActive(map.get(hit.target));
				},
				{ rootMargin: '-14% 0px -74% 0px', threshold: 0 },
			);
			map.forEach((_link, el) => io.observe(el));
		}
	}
</script>

<script>
	// 代码块「复制」按钮
	const blocks = document.querySelectorAll<HTMLElement>('.prose pre');
	for (const pre of blocks) {
		const code = pre.querySelector('code');
		if (!code) continue;

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy-code';
		button.textContent = '复制';
		button.setAttribute('aria-label', '复制代码');

		const copy = async () => {
			const text = code.textContent ?? '';
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				// 非 HTTPS 环境（如局域网预览）退回 execCommand
				const area = document.createElement('textarea');
				area.value = text;
				area.setAttribute('readonly', '');
				area.style.position = 'fixed';
				area.style.opacity = '0';
				document.body.appendChild(area);
				area.select();
				// execCommand 已废弃，但仍是 http 环境下唯一可用的兜底
				const legacyCopy = (document as unknown as { execCommand?: (cmd: string) => boolean })
					.execCommand;
				legacyCopy?.call(document, 'copy');
				area.remove();
			}
			button.textContent = '已复制 ✓';
			button.classList.add('is-done');
			setTimeout(() => {
				button.textContent = '复制';
				button.classList.remove('is-done');
			}, 1600);
		};

		button.addEventListener('click', copy);
		pre.appendChild(button);
	}
</script>
