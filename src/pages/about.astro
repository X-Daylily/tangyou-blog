---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';
import Ornament from '../components/Ornament.astro';
import { SITE_AUTHOR } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_AUTHOR}`} description="关于我和这个博客" />
		<style>
			main {
				max-width: 820px;
				padding-top: 2.5rem;
			}
			.head {
				text-align: center;
			}
			.avatar {
				display: inline-flex;
				margin-bottom: 0.7rem;
			}
			.avatar :global(.logo) {
				filter: drop-shadow(0 10px 24px rgba(198, 152, 78, 0.32));
			}
			h1 {
				margin-bottom: 0.4rem;
				letter-spacing: 0.16em;
			}
			.subtitle {
				color: var(--text-muted);
				margin: 0;
				letter-spacing: 0.08em;
			}
			.card {
				position: relative;
				padding: 2.4rem 2.6rem;
			}
			/* 四角鎏金饰角 */
			.card::before,
			.card::after {
				content: '';
				position: absolute;
				width: 26px;
				height: 26px;
				border: 1px solid var(--border-strong);
				opacity: 0.65;
				pointer-events: none;
			}
			.card::before {
				top: 13px;
				left: 13px;
				border-right: none;
				border-bottom: none;
				border-radius: 12px 0 0 0;
			}
			.card::after {
				bottom: 13px;
				right: 13px;
				border-left: none;
				border-top: none;
				border-radius: 0 0 12px 0;
			}
			.card h2 {
				margin-top: 0;
				font-size: 1.24rem;
				letter-spacing: 0.09em;
			}
			.card h2:not(:first-child) {
				margin-top: 2.4rem;
			}
			.card p {
				color: var(--text-soft);
			}
			.card p:last-child {
				margin-bottom: 0;
			}
			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.links li {
				margin: 0;
			}
			.links a {
				display: inline-block;
				padding: 0.35em 1.05em;
				border-radius: 999px;
				border: 1px solid var(--border);
				background: var(--surface);
				font-size: 0.92rem;
				letter-spacing: 0.06em;
				text-decoration: none;
				transition:
					border-color 0.25s ease,
					color 0.25s ease,
					box-shadow 0.25s ease;
			}
			.links a:hover {
				border-color: var(--accent);
				color: var(--accent);
				box-shadow: var(--shadow-sm);
				text-decoration: none;
			}
			@media (max-width: 720px) {
				.card {
					padding: 1.8rem 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="head">
				<span class="avatar">
					<Logo size={76} />
				</span>
				<h1>关于</h1>
				<p class="subtitle">你好，我是{SITE_AUTHOR}。</p>
			</div>

			<Ornament />

			<div class="card glass rise">
				<h2>关于我</h2>
				<p>
					一个还在学习和折腾的人。喜欢把遇到的问题、走过的弯路记下来，方便以后的自己，也希望对路过的你有用。
				</p>

				<h2>为什么写博客</h2>
				<p>
					记录学习过程、整理项目复盘、坚持输出。写作会逼着我把一件事想清楚，而公开写作会让这件事更有分量。
				</p>

				<h2>关于这个博客</h2>
				<p>
					用 Astro 构建，部署在 Cloudflare Pages，源码放在 GitHub。没有评论区和广告，只留下文字。
				</p>

				<h2>联系我</h2>
				<ul class="links">
					<li>
						<a href="https://github.com/X-Daylily" target="_blank" rel="noopener noreferrer">
							GitHub
						</a>
					</li>
					<li>
						<a href="/rss.xml">RSS 订阅</a>
					</li>
					<li>
						<a href="/blog/">全部文章</a>
					</li>
					<li>
						<a href="/tags/">按标签浏览</a>
					</li>
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>
