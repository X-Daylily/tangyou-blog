---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR } from '../consts';
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_AUTHOR}`} description="关于我和这个博客" />
		<style>
			main {
				max-width: var(--maxw);
				padding-top: 2.5rem;
			}
			h1 {
				margin-bottom: 0.3rem;
			}
			.subtitle {
				color: var(--text-muted);
				margin: 0 0 2.5rem;
			}
			.card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 1.8rem 1.9rem;
				box-shadow: var(--shadow-sm);
			}
			.card h2 {
				margin-top: 0;
				font-size: 1.2rem;
			}
			.card h2:not(:first-child) {
				margin-top: 2rem;
			}
			.card p:last-child {
				margin-bottom: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<h1>关于</h1>
			<p class="subtitle">你好，我是{SITE_AUTHOR}。</p>

			<div class="card">
				<h2>我是谁</h2>
				<p>在这里写你是谁、现在在做什么、对什么感兴趣。</p>

				<h2>为什么写博客</h2>
				<p>记录学习过程、整理项目复盘、坚持输出。</p>

				<h2>联系我</h2>
				<p>邮箱：<a href="mailto:you@example.com">you@example.com</a></p>
			</div>
		</main>
		<Footer />
	</body>
</html>
