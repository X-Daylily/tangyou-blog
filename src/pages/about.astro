---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Ornament from '../components/Ornament.astro';
import { SITE_AUTHOR } from '../consts';
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_AUTHOR}`} description="关于我和这个博客" />
		<style>
			main {
				max-width: 820px;
				padding-top: 2.5rem;
			}
			.head {
				text-align: center;
			}
			h1 {
				margin-bottom: 0.4rem;
				letter-spacing: 0.16em;
			}
			.subtitle {
				color: var(--text-muted);
				margin: 0;
				letter-spacing: 0.08em;
			}
			.card {
				position: relative;
				padding: 2.4rem 2.6rem;
			}
			/* 四角鎏金饰角 */
			.card::before,
			.card::after {
				content: '';
				position: absolute;
				width: 26px;
				height: 26px;
				border: 1px solid var(--border-strong);
				opacity: 0.65;
				pointer-events: none;
			}
			.card::before {
				top: 13px;
				left: 13px;
				border-right: none;
				border-bottom: none;
				border-radius: 12px 0 0 0;
			}
			.card::after {
				bottom: 13px;
				right: 13px;
				border-left: none;
				border-top: none;
				border-radius: 0 0 12px 0;
			}
			.card h2 {
				margin-top: 0;
				font-size: 1.24rem;
				letter-spacing: 0.09em;
			}
			.card h2:not(:first-child) {
				margin-top: 2.4rem;
			}
			.card p {
				color: var(--text-soft);
			}
			.card p:last-child {
				margin-bottom: 0;
			}
			@media (max-width: 720px) {
				.card {
					padding: 1.8rem 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="head">
				<h1>关于</h1>
				<p class="subtitle">你好，我是{SITE_AUTHOR}。</p>
			</div>

			<Ornament />

			<div class="card glass rise">
				<h2>我是谁</h2>
				<p>在这里写你是谁、现在在做什么、对什么感兴趣。</p>

				<h2>为什么写博客</h2>
				<p>记录学习过程、整理项目复盘、坚持输出。</p>

				<h2>联系我</h2>
				<p>邮箱：<a href="mailto:you@example.com">you@example.com</a></p>
			</div>
		</main>
		<Footer />
	</body>
</html>
