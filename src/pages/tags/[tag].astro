---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Ornament from '../../components/Ornament.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => ({
		params: { tag },
		props: {
			posts: posts
				.filter((post) => post.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`标签：${tag}`} description={`标签「${tag}」下的全部文章`} />
		<style>
			main {
				max-width: var(--maxw);
				padding-top: 2.5rem;
			}
			.page-title {
				text-align: center;
			}
			.page-title h1 {
				margin: 0;
				letter-spacing: 0.12em;
			}
			.page-title p {
				margin: 0.5rem 0 0;
				color: var(--text-muted);
				font-size: 0.85rem;
				letter-spacing: 0.28em;
			}
			.back {
				display: inline-block;
				margin-top: 0.9rem;
				font-size: 0.86rem;
				letter-spacing: 0.08em;
			}
			.list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.list a {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				padding: 1.1rem 0.3rem 1.1rem 1.5rem;
				border-bottom: 1px solid var(--border);
				color: var(--text);
				text-decoration: none;
				position: relative;
				transition:
					padding-left 0.35s ease,
					color 0.3s ease;
			}
			.list a::before {
				content: '';
				position: absolute;
				left: 0.2rem;
				top: 50%;
				transform: translateY(-50%) rotate(45deg);
				width: 6px;
				height: 6px;
				background: var(--grad-gold);
				opacity: 0.55;
				transition: opacity 0.35s ease;
			}
			.list a:hover {
				padding-left: 2rem;
				color: var(--accent);
				text-decoration: none;
			}
			.list a:hover::before {
				opacity: 1;
			}
			.list .t {
				font-family: var(--font-display);
				font-weight: 600;
				letter-spacing: 0.03em;
			}
			.list .d {
				color: var(--text-muted);
				font-size: 0.85rem;
				white-space: nowrap;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="page-title">
				<h1>标签：{tag}</h1>
				<p>共 {posts.length} 篇</p>
				<a class="back" href="/tags/">← 全部标签</a>
			</div>

			<Ornament />

			<ul class="list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="t">{post.data.title}</span>
								<span class="d">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
