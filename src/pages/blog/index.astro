---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--maxw-wide);
				padding-top: 2.5rem;
			}
			.page-title {
				margin: 0 0 2rem;
			}
			.page-title p {
				margin: 0.3rem 0 0;
				color: var(--text-muted);
			}
			.posts {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.posts li {
				margin: 0;
			}
			.card {
				display: flex;
				flex-direction: column;
				height: 100%;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: var(--shadow-sm);
				transition:
					transform 0.25s ease,
					box-shadow 0.25s ease,
					border-color 0.25s ease;
			}
			.card:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow);
				border-color: var(--accent);
			}
			.card .media {
				display: block;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: var(--bg-soft);
			}
			.card .media img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.card .body {
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
				flex: 1;
				padding: 1.2rem 1.3rem 1.4rem;
			}
			.card .title {
				margin: 0;
				font-size: 1.15rem;
				line-height: 1.35;
				color: var(--text);
			}
			.card .desc {
				margin: 0;
				flex: 1;
				color: var(--text-muted);
				font-size: 0.95rem;
				line-height: 1.6;
			}
			.card .date {
				color: var(--text-muted);
				font-size: 0.85rem;
			}
			.card a {
				text-decoration: none;
			}
			.card:hover .title {
				color: var(--accent);
			}
			.empty {
				color: var(--text-muted);
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="page-title">
				<h1>文章</h1>
				<p>共 {posts.length} 篇</p>
			</div>

			{posts.length === 0 && <p class="empty">还没有文章，去 <code>src/content/blog/</code> 写一篇吧。</p>}

			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<article class="card">
								<a class="media" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
									{post.data.heroImage && (
										<Image
											src={post.data.heroImage}
											alt=""
											widths={[320, 480, 720]}
											sizes="(max-width: 640px) 100vw, 320px"
										/>
									)}
								</a>
								<div class="body">
									<h2 class="title">
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h2>
									<p class="desc">{post.data.description}</p>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
							</article>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
