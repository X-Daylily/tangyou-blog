---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Ornament from '../../components/Ornament.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--maxw-wide);
				padding-top: 2.5rem;
			}
			.page-title {
				text-align: center;
			}
			.page-title h1 {
				margin: 0;
				letter-spacing: 0.12em;
			}
			.page-title p {
				margin: 0.5rem 0 0;
				color: var(--text-muted);
				font-size: 0.85rem;
				letter-spacing: 0.28em;
			}

			.posts {
				display: grid;
				/* auto-fit：文章少时居中，不会缩在左边 */
				grid-template-columns: repeat(auto-fit, minmax(300px, 360px));
				justify-content: center;
				gap: 1.9rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.posts li {
				margin: 0;
			}

			/* 琉璃卡片：鎏金描边 + 四角饰角 */
			.card {
				position: relative;
				display: flex;
				flex-direction: column;
				height: 100%;
				overflow: hidden;
				border: 1px solid transparent;
				border-radius: var(--radius-lg);
				background:
					linear-gradient(var(--surface), var(--surface)) padding-box,
					linear-gradient(
							135deg,
							var(--glow-1),
							var(--glow-2) 44%,
							var(--glow-3) 70%,
							var(--glow-1)
						)
						border-box;
				backdrop-filter: blur(20px) saturate(165%);
				-webkit-backdrop-filter: blur(20px) saturate(165%);
				box-shadow: var(--shadow-sm), var(--inner-top);
				transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
				transition:
					transform 0.25s ease-out,
					box-shadow 0.45s ease;
			}
			.card::before,
			.card::after {
				content: '';
				position: absolute;
				width: 22px;
				height: 22px;
				border: 1px solid var(--border-strong);
				opacity: 0.6;
				pointer-events: none;
				z-index: 2;
				transition: opacity 0.45s ease;
			}
			.card::before {
				top: 11px;
				left: 11px;
				border-right: none;
				border-bottom: none;
				border-radius: 10px 0 0 0;
			}
			.card::after {
				bottom: 11px;
				right: 11px;
				border-left: none;
				border-top: none;
				border-radius: 0 0 10px 0;
			}
			.card:hover {
				transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
					translateY(-8px);
				box-shadow: var(--shadow-lg);
			}
			.card:hover::before,
			.card:hover::after {
				opacity: 1;
			}

			.card .media {
				position: relative;
				display: block;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: linear-gradient(150deg, var(--accent-soft), transparent 75%);
			}
			.card .media::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, 0.18));
				pointer-events: none;
			}
			.card .media img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
			}
			.card:hover .media img {
				transform: scale(1.07);
			}

			.card .body {
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
				flex: 1;
				padding: 1.5rem 1.6rem 1.7rem;
			}
			.card .title {
				margin: 0;
				font-family: var(--font-display);
				font-size: 1.24rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				line-height: 1.45;
				color: var(--text);
			}
			.card .desc {
				margin: 0;
				flex: 1;
				color: var(--text-muted);
				font-size: 0.94rem;
				line-height: 1.75;
			}
			.card .card-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.card .card-tags li {
				margin: 0;
			}
			.card .card-tags a {
				display: inline-block;
				padding: 0.12em 0.7em;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent);
				font-size: 0.76rem;
				letter-spacing: 0.06em;
				text-decoration: none;
				transition:
					background-color 0.25s ease,
					color 0.25s ease;
			}
			.card .card-tags a:hover {
				background: var(--accent);
				color: var(--accent-contrast);
				text-decoration: none;
			}
			.card .date {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				color: var(--text-muted);
				font-size: 0.83rem;
				letter-spacing: 0.08em;
			}
			.card .date::before {
				content: '';
				width: 6px;
				height: 6px;
				transform: rotate(45deg);
				background: var(--grad-gold);
				box-shadow: 0 0 8px var(--glow-1);
			}
			.card a {
				text-decoration: none;
			}
			.card:hover .title {
				background: var(--grad-ink);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				-webkit-text-fill-color: transparent;
			}
			.empty {
				color: var(--text-muted);
				text-align: center;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="page-title" data-reveal>
				<h1>文章</h1>
				<p>共 {posts.length} 篇</p>
			</div>

			<div data-reveal>
				<Ornament />
			</div>

			{posts.length === 0 && (
				<p class="empty">
					还没有文章，去 <code>src/content/blog/</code> 写一篇吧。
				</p>
			)}

			<ul class="posts">
				{posts.map((post, i) => (
					<li data-reveal style={`--rd:${(i * 0.08).toFixed(2)}s`}>
						<article class="card" data-tilt>
							{post.data.heroImage && (
								<a class="media" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
									<Image
										src={post.data.heroImage}
										alt=""
										widths={[320, 480, 720]}
										sizes="(max-width: 640px) 100vw, 320px"
									/>
								</a>
							)}
							<div class="body">
								<h2 class="title">
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<p class="desc">{post.data.description}</p>
								{post.data.tags.length > 0 && (
									<ul class="card-tags">
										{post.data.tags.map((tag) => (
											<li>
												<a href={`/tags/${tag}/`}>#{tag}</a>
											</li>
										))}
									</ul>
								)}
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</div>
						</article>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<script>
	// 卡片跟随鼠标轻微 3D 倾斜
	const cards = [...document.querySelectorAll<HTMLElement>('[data-tilt]')];
	const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (fine && !reduce) {
		for (const card of cards) {
			card.addEventListener(
				'pointermove',
				(e) => {
					const r = card.getBoundingClientRect();
					const px = (e.clientX - r.left) / r.width - 0.5;
					const py = (e.clientY - r.top) / r.height - 0.5;
					card.style.setProperty('--ry', `${(px * 11).toFixed(2)}deg`);
					card.style.setProperty('--rx', `${(-py * 8).toFixed(2)}deg`);
				},
				{ passive: true },
			);
			card.addEventListener('pointerleave', () => {
				card.style.removeProperty('--rx');
				card.style.removeProperty('--ry');
			});
		}
	}
</script>
