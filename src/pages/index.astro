---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Ornament from '../components/Ornament.astro';
import { SOCIALS, SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const site = Astro.site ?? new URL(SITE_URL);
const homeUrl = new URL('/', site).href;
const personId = new URL('/#person', site).href;

// 首页结构化数据：站点 + 作者，方便搜索引擎建立实体
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': homeUrl,
			url: homeUrl,
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			inLanguage: 'zh-CN',
			publisher: { '@id': personId },
		},
		{
			'@type': 'Person',
			'@id': personId,
			name: SITE_AUTHOR,
			url: new URL('/about/', site).href,
			sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
		},
	],
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			main {
				max-width: 900px;
			}

			/* ————— 首屏 ————— */
			.hero {
				position: relative;
				padding: 4.5rem 0 1rem;
				text-align: center;
			}
			.orb {
				position: absolute;
				border-radius: 50%;
				filter: blur(46px);
				pointer-events: none;
				z-index: 0;
				animation: drift 22s ease-in-out infinite;
			}
			.orb-1 {
				top: -8rem;
				left: 50%;
				translate: -50% 0;
				width: min(600px, 94vw);
				height: min(600px, 94vw);
				background: radial-gradient(circle, var(--bloom-1), transparent 64%);
			}
			.orb-2 {
				top: 1rem;
				right: -8rem;
				width: min(420px, 74vw);
				height: min(420px, 74vw);
				background: radial-gradient(circle, var(--bloom-3), transparent 66%);
				animation-duration: 29s;
				animation-delay: -7s;
			}
			.spark {
				position: absolute;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--grad-gold);
				box-shadow: 0 0 14px var(--glow-1);
				pointer-events: none;
				z-index: 0;
				animation: floaty 7s ease-in-out infinite;
			}
			.s1 {
				top: 14%;
				left: 13%;
			}
			.s2 {
				top: 34%;
				right: 11%;
				animation-delay: -2.3s;
			}
			.s3 {
				top: 68%;
				left: 9%;
				animation-delay: -4.6s;
			}

			.hero-inner {
				position: relative;
				z-index: 1;
				max-width: 640px;
				margin: 0 auto;
				padding: 2.6rem 2rem;
			}
			/* 四角鎏金装饰框 */
			.hero-inner::before,
			.hero-inner::after {
				content: '';
				position: absolute;
				width: 30px;
				height: 30px;
				border: 1px solid var(--border-strong);
				pointer-events: none;
			}
			.hero-inner::before {
				top: 0;
				left: 0;
				border-right: none;
				border-bottom: none;
				border-radius: 12px 0 0 0;
			}
			.hero-inner::after {
				bottom: 0;
				right: 0;
				border-left: none;
				border-top: none;
				border-radius: 0 0 12px 0;
			}

			.eyebrow {
				margin: 0 0 1.1rem;
				font-size: 0.8rem;
				letter-spacing: 0.5em;
				text-indent: 0.5em;
				color: var(--accent);
			}
			.hero h1 {
				margin: 0 0 1.1rem;
				letter-spacing: 0.07em;
				text-shadow: 0 2px 24px rgba(198, 152, 78, 0.24);
				animation: title-in 1.25s cubic-bezier(0.2, 0.7, 0.2, 1) both;
			}
			/* 标题：从模糊 + 字距收拢中浮现 */
			@keyframes title-in {
				0% {
					opacity: 0;
					filter: blur(12px);
					letter-spacing: 0.24em;
					transform: translateY(16px) scale(0.98);
				}
				100% {
					opacity: 1;
					filter: blur(0);
					letter-spacing: 0.07em;
					transform: none;
				}
			}
			.lead {
				max-width: 26em;
				margin: 0 auto;
				font-size: 1.08rem;
				color: var(--text-muted);
				letter-spacing: 0.04em;
			}
			.cta {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.9rem;
				margin-top: 2.2rem;
			}

			/* ————— 最新文章 ————— */
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 0.4rem;
			}
			.section-head h2 {
				margin: 0;
			}
			.section-head a {
				font-size: 0.88rem;
				letter-spacing: 0.12em;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				margin: 0;
			}
			.post-list a {
				position: relative;
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				padding: 1.15rem 0.3rem 1.15rem 1.5rem;
				color: var(--text);
				text-decoration: none;
				transition:
					padding-left 0.35s ease,
					color 0.35s ease;
			}
			.post-list a::before {
				content: '';
				position: absolute;
				left: 0.2rem;
				top: 50%;
				transform: translateY(-50%) rotate(45deg);
				width: 6px;
				height: 6px;
				background: var(--grad-gold);
				opacity: 0.55;
				transition:
					opacity 0.35s ease,
					box-shadow 0.35s ease;
			}
			.post-list li + li a {
				border-top: 1px solid var(--border);
			}
			.post-list a:hover {
				padding-left: 2rem;
				color: var(--accent);
				text-decoration: none;
			}
			.post-list a:hover::before {
				opacity: 1;
				box-shadow: 0 0 12px var(--glow-1);
			}
			.post-list .t {
				font-family: var(--font-display);
				font-size: 1.1rem;
				font-weight: 600;
				letter-spacing: 0.04em;
			}
			.post-list .d {
				color: var(--text-muted);
				font-size: 0.85rem;
				letter-spacing: 0.06em;
				white-space: nowrap;
			}

			@media (max-width: 720px) {
				.hero {
					padding-top: 3rem;
				}
				.hero-inner {
					padding: 1.8rem 0.6rem;
				}
				.hero-inner::before,
				.hero-inner::after {
					display: none;
				}
			}
			@media (max-width: 560px) {
				/* 窄屏：标题换行时日期另起一行，避免挤在一起 */
				.post-list a {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.28rem;
					padding-right: 0.3rem;
				}
				.post-list .d {
					font-size: 0.8rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="hero">
				<span class="orb orb-1" aria-hidden="true"></span>
				<span class="orb orb-2" aria-hidden="true"></span>
				<span class="spark s1" aria-hidden="true"></span>
				<span class="spark s2" aria-hidden="true"></span>
				<span class="spark s3" aria-hidden="true"></span>

				<div class="hero-inner rise">
					<p class="eyebrow">✦ 你好 ✦</p>
					<h1>
						我是<span class="gradient-text">{SITE_AUTHOR}</span>
					</h1>
					<p class="lead">{SITE_DESCRIPTION}</p>
					<div class="cta">
						<a class="btn" href="/blog/">
							阅读文章
						</a>
						<a class="btn ghost" href="/about/">
							关于我
						</a>
					</div>
				</div>
			</section>

			<div data-reveal>
				<Ornament />
			</div>

			<section>
				<div class="section-head" data-reveal>
					<h2>最新文章</h2>
					<a href="/blog/">全部 →</a>
				</div>
				<ul class="post-list">
					{posts.map((post, i) => (
						<li data-reveal style={`--rd:${(i * 0.07).toFixed(2)}s`}>
							<a href={`/blog/${post.id}/`}>
								<span class="t">{post.data.title}</span>
								<span class="d">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
